{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthLoginRequest",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email"
    },
    "password": {
      "type": "string",
      "minLength": 8
    }
  },
  "required": ["email", "password"]
}
