{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?path=api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/proxy?path=v1/:path*"
    },
    {
      "source": "/locales/:path*",
      "destination": "/api/proxy?path=locales/:path*"
    },
    {
      "source": "/((?!assets|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
