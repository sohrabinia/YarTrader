<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <proxy reverseRewriteHostInResponseHeaders="false" />
    <rewrite>
      <rules>
        <rule name="YarOperator UI Route" stopProcessing="true">
          <match url="^(Operator|operator)(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}{R:2}" appendQueryString="true" />
        </rule>

        <rule name="YarOperator Static Assets" stopProcessing="true">
          <match url="^(app\.css|app\.js)$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" appendQueryString="true" />
        </rule>

        <rule name="YarOperator API Route" stopProcessing="true">
          <match url="^api/v1/operator(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/api/v1/operator{R:1}" appendQueryString="true" />
        </rule>

        <rule name="YarOperator Auth Route" stopProcessing="true">
          <match url="^auth(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/auth{R:1}" appendQueryString="true" />
        </rule>

        <rule name="Block Unwired Runtime Controls And Uninstrumented Telemetry" stopProcessing="true">
          <match url="^(api/control|api/mode|api/risk/emergency_stop|api/devops/status|api/devops/metrics|v1/dashboard/overview|v1/monitoring|v1/metrics|v1/runtime)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="503" statusReason="Service Unavailable" statusDescription="Runtime controller or telemetry source is not registered; no action was executed." />
        </rule>

        <rule name="Serve YarTrader SPA Root" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="index.html" />
        </rule>

        <rule name="Serve Existing Static Files" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <rule name="YarTrader SPA Route Fallback" stopProcessing="true">
          <match url="^(?!api/|v1/|health$|docs/?$|openapi\.json$|redoc/?$|auth/|Operator/|operator/|assets/|locales/).*$" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>

        <rule name="YarTrader Catch-All Route" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
