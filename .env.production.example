# ==============================================================================
# TradeYar AI v3.2 — Enterprise Production Environment Template
# ==============================================================================
# Copy this file to '.env' or '.env.production' on the target Windows Server.
# Do NOT commit the actual '.env' or '.env.production' file to version control.
# All passwords, api keys, and private credentials MUST be kept confidential.

# 1. System Environment Designation
TRADEYAR_ENV=production
TRADEYAR_API_HOST=127.0.0.1
TRADEYAR_API_PORT=8000

# 2. MetaTrader 5 (MT5) Connection & Credentials
TRADEYAR_MT5_LOGIN=your_mt5_account_login_here
TRADEYAR_MT5_PASSWORD=your_mt5_account_password_here
TRADEYAR_MT5_SERVER=your_mt5_broker_server_name_here
TRADEYAR_MT5_SYMBOL=XAUUSD
TRADEYAR_MT5_TIMEFRAME=H1

# 3. PostgreSQL Database Connection
# Used for persistent analytical user database and referral configurations
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=tradeyar_production
POSTGRES_USER=tradeyar_sre_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here

# 4. Redis Caching & Queue State
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here

# 5. API Authentication & Token Keys
TRADEYAR_API_KEY=your_cryptographically_secure_api_key_here
JWT_SECRET_KEY=your_secure_jwt_secret_token_key_here

# 6. Structured Logging & SRE Telemetry
TRADEYAR_LOG_LEVEL=INFO
TRADEYAR_LOG_ROTATION=daily
TRADEYAR_AI_CONFIDENCE_THRESHOLD=70

# 7. Worker Lifecycles
TRADEYAR_WORKERS_RESEARCH=True
TRADEYAR_WORKERS_INTELLIGENCE=True

# 8. OIDC Social Authentication Configuration (Google)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
