# ==============================================================================
# TRADEYAR AI v3.2 — PRODUCTION ENVIRONMENT CONFIGURATION
# Location: C:\Projects\TradeYar_AI\.env.production
# ==============================================================================
# This template defines the enterprise environment variables required for TradeYar AI
# in a production environment. Copy this file to '.env' on your production server
# and replace placeholders with secure, actual values.
#
# NOTE: All cognitive intelligence, data provider feeds, and execution guards
# are strictly read-only and simulation-only under APES-FIN rules.
# ==============================================================================

# --- System & Deployment Environment ---
RG_ENV=production
LOG_LEVEL=INFO
LOG_ROTATION=daily
TradeYarStorageRoot=C:\Projects\TradeYar_AI\storage\

# --- FastAPI Web Server Config ---
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
API_TIMEOUT=10.0
MAX_RETRIES=5

# --- Security & Authentication (JWT Tokens) ---
# Generate a secure random 32-byte key using: openssl rand -hex 32
JWT_SECRET_KEY=YOUR_SECURE_JWT_SECRET_PLACEHOLDER_64_CHAR_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- PostgreSQL Enterprise Database ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=tradeyar_prod_db
POSTGRES_USER=tradeyar_app_user
POSTGRES_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD_PLACEHOLDER
DB_SECURE_TOKEN=YOUR_SECURE_DATABASE_ENCRYPTION_TOKEN_PLACEHOLDER

# --- Redis Enterprise Cache / Task Queue ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD_PLACEHOLDER
REDIS_SSL=false

# --- MetaTrader 5 (MT5) Connection Feeds ---
# Active pricing feeds are read-only. Standard disabled safety modes apply.
MT5_LOGIN=YOUR_MT5_LOGIN_ACCOUNT_ID
MT5_PASSWORD=YOUR_MT5_PASSWORD_READONLY_INVESTOR
MT5_SERVER=YOUR_MT5_BROKER_SERVER_NAME
MT5_SYMBOL=XAUUSD
MT5_TIMEFRAME=H1

# --- SRE Logging & Diagnostics Paths ---
LOG_DIR_APPLICATION=logs/application/
LOG_DIR_ERROR=logs/error/
LOG_DIR_AUDIT=logs/audit/
LOG_DIR_INTELLIGENCE=logs/intelligence/
LOG_DIR_RUNTIME=logs/runtime/

# --- APES-FIN Non-Trading Safety compliance ---
# Mandatory passive modes: No order placement or live-trading allowed.
EXECUTION_MODE=passive
COGNITIVE_CONFIDENCE_THRESHOLD=70
LOOKBACK_DAYS=15
