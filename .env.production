# ==============================================================================
# YARTRADER AI v1.0 — PRODUCTION ENVIRONMENT CONFIGURATION
# Location: C:\Projects\YarTrader\.env.production
# Production runtime environment configuration
# ==============================================================================

# This file defines the production runtime configuration for YarTrader AI.
# All intelligence, data provider feeds, and execution guards operate under
# APES-FIN safety rules with simulation-only execution.

# ==============================================================================
# System & Deployment Environment
# ==============================================================================

RG_ENV=production

YARTRADER_ENV=production
YARTRADER_LOG_LEVEL=INFO
YARTRADER_LOG_ROTATION=daily

YarTraderStorageRoot=C:\Projects\YarTrader\storage\


# ==============================================================================
# FastAPI Web Server Config
# ==============================================================================

YARTRADER_API_HOST=127.0.0.1
YARTRADER_API_PORT=8000

FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

API_TIMEOUT=10.0
MAX_RETRIES=5


# ==============================================================================
# Security & Authentication (JWT)
# ==============================================================================

JWT_SECRET_KEY=YOUR_SECURE_JWT_SECRET_PLACEHOLDER_64_CHAR_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ==============================================================================
# PostgreSQL Database
# ==============================================================================

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

POSTGRES_DB=yartrader_prod_db
POSTGRES_USER=yartrader_app_user
POSTGRES_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD_PLACEHOLDER

DB_SECURE_TOKEN=YOUR_SECURE_DATABASE_ENCRYPTION_TOKEN_PLACEHOLDER


# ==============================================================================
# Redis Cache / Task Queue
# ==============================================================================

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD_PLACEHOLDER
REDIS_SSL=false


# ==============================================================================
# MetaTrader 5 Connection
# Read-only / Simulation Mode
# ==============================================================================

YARTRADER_MT5_LOGIN=YOUR_MT5_LOGIN_ACCOUNT_ID
YARTRADER_MT5_PASSWORD=YOUR_MT5_PASSWORD_READONLY_INVESTOR
YARTRADER_MT5_SERVER=YOUR_MT5_BROKER_SERVER_NAME

YARTRADER_MT5_SYMBOL=XAUUSD
YARTRADER_MT5_TIMEFRAME=H1


# ==============================================================================
# Workers
# ==============================================================================

YARTRADER_WORKERS_RESEARCH=true
YARTRADER_WORKERS_INTELLIGENCE=true


# ==============================================================================
# Logging & Diagnostics
# ==============================================================================

LOG_DIR_APPLICATION=logs/application/
LOG_DIR_ERROR=logs/error/
LOG_DIR_AUDIT=logs/audit/
LOG_DIR_INTELLIGENCE=logs/intelligence/
LOG_DIR_RUNTIME=logs/runtime/


# ==============================================================================
# APES-FIN Safety / Non-Trading Compliance
# ==============================================================================

EXECUTION_MODE=passive

YARTRADER_AI_CONFIDENCE_THRESHOLD=70
COGNITIVE_CONFIDENCE_THRESHOLD=70

LOOKBACK_DAYS=15


# ==============================================================================
# Runtime Safety
# ==============================================================================

LIVE_TRADING_ENABLED=false
SIMULATION_ENABLED=true